 "faq": [
  {
   "question": "What is the Season 3 arena set for Destruction Warlock?",
   "answer": "The Vengeful Gladiator's pieces: Vengeful Gladiator's Felweave Cowl, Vengeful Gladiator's Dreadweave Mantle, Vengeful Gladiator's Dreadweave Robe, Vengeful Gladiator's Dreadweave Gloves, Vengeful Gladiator's Dreadweave Leggings, Vengeful Gladiator's Spellblade, Vengeful Gladiator's Endgame, Vengeful Gladiator's Touch of Defeat. The 2-piece and 4-piece set bonuses carry over between seasons, so partial upgrades never break your bonus."
  },
  {
   "question": "What are the rating requirements in Season 3?",
   "answer": "Season 3 introduces rating requirements: the Vengeful weapon needs 1850 team rating and the shoulders need 2000. Everything else is rating-free."
  },
  {
   "question": "How many arena points does full Season 3 gear cost?",
   "answer": "The five set pieces total roughly 8,250 arena points (helm/chest/legs 1,875 each, shoulders 1,500, gloves 1,125) plus about 3,750 for a main weapon. Use the arena points calculator to turn your weekly rating into a purchase timeline."
  },
  {
   "question": "Which honor pieces complement the Season 3 set?",
   "answer": "Vindicator's Pendant of Dominance, Vindicator's Dreadweave Cuffs, Vindicator's Dreadweave Belt, Vindicator's Band of Dominance — bought with honor and battleground marks, no arena rating needed."
  }
