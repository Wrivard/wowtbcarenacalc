 "faq": [
  {
   "question": "What is the Season 4 arena set for Subtlety Rogue?",
   "answer": "The Brutal Gladiator's pieces: Brutal Gladiator's Leather Helm, Brutal Gladiator's Leather Spaulders, Brutal Gladiator's Leather Tunic, Brutal Gladiator's Leather Gloves, Brutal Gladiator's Leather Legguards, Brutal Gladiator's Slicer, Brutal Gladiator's Quickblade, Brutal Gladiator's War Edge. The 2-piece and 4-piece set bonuses carry over between seasons, so partial upgrades never break your bonus."
  },
  {
   "question": "What are the rating requirements in Season 4?",
   "answer": "Season 4 has the strictest gates in TBC: the Brutal weapon requires 1950 rating, shoulders 2200, and several pieces check personal rating as well as team rating."
  },
  {
   "question": "How many arena points does full Season 4 gear cost?",
   "answer": "The five set pieces total roughly 8,250 arena points (helm/chest/legs 1,875 each, shoulders 1,500, gloves 1,125) plus about 3,750 for a main weapon. Use the arena points calculator to turn your weekly rating into a purchase timeline."
  },
  {
   "question": "Which honor pieces complement the Season 4 set?",
   "answer": "Guardian's Leather Bracers, Guardian's Leather Belt, Guardian's Leather Boots — bought with honor and battleground marks, no arena rating needed."
  }
 ]
