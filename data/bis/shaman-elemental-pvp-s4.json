 "faq": [
  {
   "question": "What is the Season 4 arena set for Elemental Shaman?",
   "answer": "The Brutal Gladiator's pieces: Brutal Gladiator's Mail Helm, Brutal Gladiator's Mail Spaulders, Brutal Gladiator's Mail Armor, Brutal Gladiator's Mail Gauntlets, Brutal Gladiator's Mail Leggings, Brutal Gladiator's Gavel, Brutal Gladiator's Barrier. The 2-piece and 4-piece set bonuses carry over between seasons, so partial upgrades never break your bonus."
  },
  {
   "question": "What are the rating requirements in Season 4?",
   "answer": "Season 4 has the strictest gates in TBC: the Brutal weapon requires 1950 rating, shoulders 2200, and several pieces check personal rating as well as team rating."
  },
  {
   "question": "How many arena points does full Season 4 gear cost?",
   "answer": "The five set pieces total roughly 8,250 arena points (helm/chest/legs 1,875 each, shoulders 1,500, gloves 1,125) plus about 3,750 for a main weapon. Use the arena points calculator to turn your weekly rating into a purchase timeline."
  },
  {
   "question": "Which honor pieces complement the Season 4 set?",
   "answer": "Guardian's Mail Bracers, Guardian's Mail Girdle, Guardian's Mail Sabatons, Guardian's Band of Dominance — bought with honor and battleground marks, no arena rating needed."
  }
 ]
