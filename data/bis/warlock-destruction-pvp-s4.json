 "faq": [
  {
   "question": "What is the Season 4 arena set for Destruction Warlock?",
   "answer": "The Brutal Gladiator's pieces: Brutal Gladiator's Felweave Cowl, Brutal Gladiator's Dreadweave Mantle, Brutal Gladiator's Dreadweave Robe, Brutal Gladiator's Dreadweave Gloves, Brutal Gladiator's Dreadweave Leggings, Brutal Gladiator's Spellblade, Brutal Gladiator's Endgame, Brutal Gladiator's Touch of Defeat. The 2-piece and 4-piece set bonuses carry over between seasons, so partial upgrades never break your bonus."
  },
  {
   "question": "What are the rating requirements in Season 4?",
   "answer": "Season 4 has the strictest gates in TBC: the Brutal weapon requires 1950 rating, shoulders 2200, and several pieces check personal rating as well as team rating."
  },
  {
   "question": "How many arena points does full Season 4 gear cost?",
   "answer": "The five set pieces total roughly 8,250 arena points (helm/chest/legs 1,875 each, shoulders 1,500, gloves 1,125) plus about 3,750 for a main weapon. Use the arena points calculator to turn your weekly rating into a purchase timeline."
  },
  {
   "question": "Which honor pieces complement the Season 4 set?",
   "answer": "Guardian's Pendant of Dominance, Guardian's Dreadweave Cuffs, Guardian's Dreadweave Belt, Guardian's Band of Dominance — bought with honor and battleground marks, no arena rating needed."
  }
 ]
